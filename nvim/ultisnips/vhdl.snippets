snippet process
${2:`!p
def format_class(path):
  parts     = path.split(',')

  if len(parts) == 1:
    part       = parts[0].strip()
    if part != '' and "clk" in part:
      return "p_seq_"

  elif len(parts) == 2:
    for i in range(len(parts)):
      part       = parts[i].strip()
      part_other = parts[ 1 if (i == 0) else 0 ]

      if part != '' and "clk" in part \
        and ("rstn" in part_other or "resetn" in part_other):
        return "p_seq_"

  return "p_comb_"

snip.rv = format_class(t[1])
`}:
    process (${1:clk})
    begin
        `!p
def format_class(path):
  parts     = path.split(',')

  if len(parts) == 1:
    part       = parts[0].strip()
    if part != '' and "clk" in part:
      return "if rising_edge(" + part + ") then"

  elif len(parts) == 2:
    for i in range(len(parts)):
      part       = parts[i].strip()
      part_other = parts[ 1 if (i == 0) else 0 ]

      if part != '' and "clk" in part \
        and ("rstn" in part_other or "resetn" in part_other):
        return "if " + part_other.strip() + " = '0' then"

  return ''

snip.rv = format_class(t[1])
