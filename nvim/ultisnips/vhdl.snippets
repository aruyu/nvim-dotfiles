snippet "for .. downto 0"
${4:`!p
def format_class(path):
  parts     = path.split(',')

  if len(parts) == 1:
    for part in parts:
      part = part.strip()

      if part == "generate":
        return "gen_"
      elif part == "loop":
        return "lp_"

  return ""

